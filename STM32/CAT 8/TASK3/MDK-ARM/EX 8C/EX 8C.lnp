"ex 8c\stm32f1xx_hal_msp.o"
"ex 8c\stm32f1xx_hal_gpio_ex.o"
"ex 8c\stm32f1xx_hal.o"
"ex 8c\stm32f1xx_hal_rcc.o"
"ex 8c\stm32f1xx_hal_rcc_ex.o"
"ex 8c\stm32f1xx_hal_gpio.o"
"ex 8c\stm32f1xx_hal_dma.o"
